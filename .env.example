# Copy to .env and fill in. .env is gitignored.
GEMINI_API_KEY=
SERPER_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash

# Leave empty to run without S3 (reports stay in memory).
S3_BUCKET=

# Optional. Longest page body one scrape may add to a prompt. The free tier
# meters input tokens per minute, so an unbounded scrape can exhaust the quota
# on its own. Raise this on a paid plan.
MAX_SCRAPE_CHARS=15000

# Optional. Retries litellm performs on a failed model call.
LLM_NUM_RETRIES=3

# Optional locally, set in production. Callers must send it as X-API-Key on
# /research and the job endpoints. Leave empty to run without auth.
API_KEY=
